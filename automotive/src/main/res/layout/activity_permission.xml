<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <import type="android.view.View" />
        <variable name="viewModel" type="com.spake.brony.doubaoassistant.viewmodel.PermissionViewModel" />
        <variable name="actions" type="com.spake.brony.doubaoassistant.ui.PermissionActivity" />
    </data>
    <FrameLayout android:id="@+id/permission_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="true"
        android:focusableInTouchMode="true">
        <com.spake.brony.doubaoassistant.ui.widget.AmbientBackgroundView android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />
        <ScrollView android:id="@+id/setup_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">
            <LinearLayout android:id="@+id/onboarding"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="32dp">
                <TextView android:id="@+id/onboard_title"
                    style="@style/Voice.Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="18dp"
                    android:gravity="center"
                    android:textSize="44sp"
                    android:letterSpacing="0.065"
                    android:text="@string/voice_setup_title" />
                <TextView android:id="@+id/onboard_body"
                    style="@style/Voice.Text.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="28dp"
                    android:gravity="center"
                    android:textSize="20sp"
                    android:letterSpacing="0.025"
                    android:lineSpacingMultiplier="1.9"
                    android:text="@string/voice_setup_body" />
                <LinearLayout android:id="@+id/credentials_form"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:orientation="vertical"
                    android:importantForAutofill="noExcludeDescendants">
                    <EditText android:id="@+id/speech_app_id"
                        style="@style/Voice.CredentialInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textNoSuggestions"
                        android:hint="@string/voice_speech_app_id_hint"
                        android:contentDescription="@string/voice_speech_app_id_hint" />
                    <EditText android:id="@+id/speech_access_token"
                        style="@style/Voice.CredentialInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:hint="@string/voice_speech_access_token_hint"
                        android:contentDescription="@string/voice_speech_access_token_hint" />
                    <EditText android:id="@+id/ark_api_key"
                        style="@style/Voice.CredentialInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:imeOptions="actionDone"
                        android:hint="@string/voice_ark_api_key_hint"
                        android:contentDescription="@string/voice_ark_api_key_hint" />
                </LinearLayout>
                <TextView android:id="@+id/permission_help"
                    style="@style/Voice.Text.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="25dp"
                    android:gravity="center"
                    android:textSize="15sp"
                    android:text="@{viewModel.uiState.error != null ? viewModel.uiState.error : @string/voice_permission_guide}"
                    android:visibility="@{viewModel.uiState.openSettings || viewModel.uiState.error != null ? View.VISIBLE : View.GONE}" />
                <LinearLayout android:id="@+id/permission_action"
                    android:layout_width="270dp"
                    android:layout_height="wrap_content"
                    android:minHeight="70dp"
                    android:paddingStart="36dp"
                    android:paddingEnd="36dp"
                    android:paddingTop="23dp"
                    android:paddingBottom="23dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="@drawable/voice_primary_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:onClick="@{() -> actions.requestMicrophone()}">
                    <ImageView android:layout_width="23dp"
                        android:layout_height="23dp"
                        android:layout_marginEnd="14dp"
                        android:src="@drawable/ic_voice_mic"
                        app:tint="@color/voice_on_primary"
                        android:importantForAccessibility="no" />
                    <TextView android:id="@+id/permission_action_label"
                        style="@style/Voice.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="18sp"
                        android:textColor="@color/voice_on_primary"
                        android:text="@{viewModel.uiState.granted ? @string/voice_setup_enter : (viewModel.uiState.openSettings ? @string/voice_settings_action : @string/voice_setup_enable)}" />
                </LinearLayout>
                <TextView android:id="@+id/onboard_note"
                    style="@style/Voice.Text.Muted"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    app:drawableStartCompat="@drawable/voice_note_dot"
                    android:drawablePadding="10dp"
                    android:gravity="center"
                    android:textSize="12sp"
                    android:letterSpacing="0.08"
                    android:text="@string/voice_credentials_saved_note" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</layout>
