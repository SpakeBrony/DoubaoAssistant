<layout xmlns:android="http://schemas.android.com/apk/res/android">
    <data />
    <com.spake.brony.doubaoassistant.ui.overlay.OverlayWindowView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/voice_overlay_background"
        android:elevation="8dp">
        <com.spake.brony.doubaoassistant.ui.widget.AmbientBackgroundView
            android:id="@+id/overlay_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />
        <LinearLayout android:id="@+id/overlay_body"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="12dp">
            <LinearLayout android:id="@+id/overlay_header"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:contentDescription="@string/voice_overlay_move">
                <TextView style="@style/Voice.Text.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/voice_conversation"
                    android:textSize="12sp"
                    android:letterSpacing="0.04" />
            </LinearLayout>
            <com.spake.brony.doubaoassistant.ui.widget.ConversationView android:id="@+id/overlay_conversation"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:paddingTop="12dp"
                android:contentDescription="@string/voice_conversation" />
            <View android:id="@+id/overlay_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:background="@color/voice_line"
                android:importantForAccessibility="no" />
            <LinearLayout android:id="@+id/overlay_controls"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">
                <ImageButton android:id="@+id/overlay_microphone"
                    style="@style/Voice.IconButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="12dp"
                    android:background="@drawable/voice_circle_button"
                    android:src="@drawable/ic_voice_mic"
                    android:contentDescription="@string/voice_disable_mic" />
                <com.spake.brony.doubaoassistant.ui.widget.VoiceMarkView android:id="@+id/overlay_voice_mark"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:importantForAccessibility="no" />
                <ImageButton android:id="@+id/overlay_toggle_chat"
                    style="@style/Voice.IconButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="14dp"
                    android:background="@drawable/voice_circle_button"
                    android:src="@drawable/ic_voice_pause"
                    android:contentDescription="@string/voice_pause_chat" />
            </LinearLayout>
        </LinearLayout>
    </com.spake.brony.doubaoassistant.ui.overlay.OverlayWindowView>
</layout>
