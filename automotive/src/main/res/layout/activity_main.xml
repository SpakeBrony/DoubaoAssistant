<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <import type="android.view.View" />
        <import type="android.view.ViewGroup" />
        <import type="android.view.Gravity" />
        <import type="com.spake.brony.doubaoassistant.data.model.ConversationPhase" />
        <variable name="viewModel" type="com.spake.brony.doubaoassistant.viewmodel.KwsViewModel" />
        <variable name="actions" type="com.spake.brony.doubaoassistant.ui.MainActivity" />
    </data>
    <FrameLayout android:id="@+id/voice_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.spake.brony.doubaoassistant.ui.widget.AmbientBackgroundView android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />
        <FrameLayout android:id="@+id/home_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:descendantFocusability="@{viewModel.uiState.settingsOpen ? ViewGroup.FOCUS_BLOCK_DESCENDANTS : ViewGroup.FOCUS_AFTER_DESCENDANTS}"
            android:importantForAccessibility="@{viewModel.uiState.settingsOpen ? View.IMPORTANT_FOR_ACCESSIBILITY_NO_HIDE_DESCENDANTS : View.IMPORTANT_FOR_ACCESSIBILITY_AUTO}">
            <LinearLayout android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">
                <LinearLayout android:id="@+id/top_toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="90dp"
                    android:orientation="horizontal"
                    android:gravity="@{Gravity.CENTER_VERTICAL | (viewModel.uiState.controlsOnLeft ? Gravity.RIGHT : Gravity.LEFT)}"
                    android:paddingStart="64dp"
                    android:paddingEnd="64dp"
                    android:paddingTop="24dp">
                    <ImageButton android:id="@+id/open_settings"
                        style="@style/Voice.IconButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:padding="12dp"
                        android:src="@drawable/ic_voice_more"
                        android:contentDescription="@string/voice_open_settings"
                        android:onClick="@{() -> actions.openSettings()}" />
                </LinearLayout>
                <com.spake.brony.doubaoassistant.ui.widget.ConversationView android:id="@+id/conversation"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:paddingTop="30dp"
                    android:paddingBottom="28dp"
                    android:contentDescription="@string/voice_conversation"
                    android:requiresFadingEdge="vertical"
                    android:fadingEdgeLength="28dp"
                    app:conversationContent="@{viewModel.uiState.conversation}"
                    app:conversationControlsLeft="@{viewModel.uiState.controlsOnLeft}"
                    app:conversationDebugMode="@{viewModel.uiState.debugMode}"
                    app:showCaptions="@{viewModel.uiState.captions}" />
                <LinearLayout android:id="@+id/bottom_area"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="122dp"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingBottom="26dp">
                    <LinearLayout android:id="@+id/status_group"
                        android:layout_width="match_parent"
                        android:layout_height="96dp"
                        android:orientation="vertical"
                        android:gravity="top|center_horizontal">
                        <com.spake.brony.doubaoassistant.ui.widget.VoiceMarkView android:id="@+id/voice_mark"
                            android:layout_width="64dp"
                            android:layout_height="24dp"
                            android:layout_marginBottom="13dp"
                            android:importantForAccessibility="no"
                            app:voicePhase="@{viewModel.uiState.phase}"
                            app:voiceLevel="@{viewModel.uiState.waveformLevel}" />
                        <TextView android:id="@+id/listening_status"
                            style="@style/Voice.Text.Secondary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:paddingStart="24dp"
                            android:paddingEnd="24dp"
                            android:textSize="19sp"
                            android:letterSpacing="0.025"
                            android:text="@{actions.statusText(viewModel.uiState)}"
                            android:clickable="@{viewModel.uiState.chatError != null}"
                            android:focusable="@{viewModel.uiState.chatError != null}"
                            android:onClick="@{() -> actions.showChatError()}"
                            android:accessibilityLiveRegion="polite" />
                        <TextView android:id="@+id/status_support"
                            style="@style/Voice.Text.Muted"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:layout_marginTop="7dp"
                            android:textSize="14sp"
                            android:text="@string/voice_ended_support"
                            android:visibility="@{viewModel.uiState.phase == ConversationPhase.ENDED ? View.VISIBLE : View.GONE}" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/right_controls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical|end"
                android:layout_marginLeft="64dp"
                android:layout_marginRight="64dp"
                app:frameGravity="@{Gravity.CENTER_VERTICAL | (viewModel.uiState.controlsOnLeft ? Gravity.LEFT : Gravity.RIGHT)}"
                android:orientation="vertical"
                android:gravity="center_horizontal">
                <FrameLayout android:id="@+id/input_container"
                    android:layout_width="64dp"
                    android:layout_height="64dp">
                    <TextView android:id="@+id/input_button"
                        style="@style/Voice.Text"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="@string/voice_input_glyph"
                        android:textSize="26sp"
                        android:textColor="@color/voice_text"
                        android:background="@drawable/voice_circle_button"
                        android:contentDescription="@string/voice_message_input"
                        android:clickable="true"
                        android:focusable="true"
                        android:onClick="@{() -> actions.showMessageInput()}" />
                </FrameLayout>
                <ImageButton android:id="@+id/toggle_listening"
                    android:contentDescription="@string/voice_enable_mic"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginTop="20dp"
                    android:padding="20dp"
                    android:background="@drawable/voice_circle_button"
                    android:scaleType="fitCenter"
                    app:tint="@color/voice_text"
                    android:onClick="@{() -> actions.toggleListening()}"
                    app:microphoneEnabled="@{viewModel.uiState.isListening}" />
                <ImageButton android:id="@+id/toggle_chat"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginTop="20dp"
                    android:padding="20dp"
                    android:background="@drawable/voice_circle_button"
                    android:scaleType="fitCenter"
                    android:enabled="@{viewModel.uiState.canControlChat}"
                    android:alpha="@{viewModel.uiState.canControlChat ? 1.0f : 0.35f}"
                    app:tint="@color/voice_text"
                    android:onClick="@{() -> actions.toggleChat()}"
                    app:chatPaused="@{viewModel.uiState.isPaused}" />
                <ImageButton android:id="@+id/end_session"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginTop="20dp"
                    android:padding="20dp"
                    android:background="@drawable/voice_end_button"
                    android:src="@drawable/ic_voice_close"
                    android:scaleType="fitCenter"
                    app:tint="@color/voice_red"
                    android:contentDescription="@string/voice_exit_app"
                    android:onClick="@{() -> actions.exitApp()}" />
            </LinearLayout>
        </FrameLayout>
        <View android:id="@+id/settings_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/voice_scrim"
            android:visibility="@{viewModel.uiState.settingsOpen ? View.VISIBLE : View.GONE}"
            android:contentDescription="@string/voice_close_settings"
            android:clickable="true"
            android:focusable="true"
            android:onClick="@{() -> actions.closeSettings()}" />
        <include android:id="@+id/settings" layout="@layout/panel_settings"
            app:viewModel="@{viewModel}"
            app:actions="@{actions}" />
    </FrameLayout>
</layout>
