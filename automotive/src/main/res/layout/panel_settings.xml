<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <import type="android.view.View" />
        <import type="android.view.Gravity" />
        <import type="com.spake.brony.doubaoassistant.data.model.Appearance" />
        <import type="com.spake.brony.doubaoassistant.data.model.ReplyStyle" />
        <import type="com.spake.brony.doubaoassistant.data.model.AnswerMode" />
        <import type="com.spake.brony.doubaoassistant.data.model.OverlayStyle" />
        <variable name="viewModel" type="com.spake.brony.doubaoassistant.viewmodel.KwsViewModel" />
        <variable name="actions" type="com.spake.brony.doubaoassistant.ui.MainActivity" />
    </data>
    <ScrollView android:id="@+id/settings_panel"
        android:layout_width="448dp"
        android:layout_height="match_parent"
        app:frameGravity="@{viewModel.uiState.controlsOnLeft ? Gravity.RIGHT : Gravity.LEFT}"
        android:background="@color/voice_panel"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:visibility="@{viewModel.uiState.settingsOpen ? View.VISIBLE : View.GONE}">
        <LinearLayout android:id="@+id/settings_column"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="36dp"
            android:paddingEnd="36dp"
            android:paddingTop="42dp"
            android:paddingBottom="42dp">
            <LinearLayout android:id="@+id/settings_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="26dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView android:id="@+id/settings_title"
                    style="@style/Voice.Text"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/voice_settings"
                    android:textSize="26sp" />
                <ImageButton android:id="@+id/close_settings"
                    style="@style/Voice.IconButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="12dp"
                    app:tint="@color/voice_secondary"
                    android:src="@drawable/ic_voice_close"
                    android:contentDescription="@string/voice_close_settings"
                    android:onClick="@{() -> actions.closeSettings()}" />
            </LinearLayout>
            <LinearLayout android:id="@+id/appearance_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="28dp"
                android:paddingBottom="28dp">
                <TextView android:id="@+id/appearance_label"
                    style="@style/Voice.SettingLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/voice_appearance" />
                <LinearLayout android:id="@+id/appearance_options"
                    android:baselineAligned="false"
                    android:layout_width="match_parent"
                    android:layout_height="102dp"
                    android:layout_marginTop="23dp"
                    android:orientation="horizontal">
                    <LinearLayout android:id="@+id/theme_system"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="0dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/voice_option"
                        android:clickable="true"
                        android:focusable="true"
                        android:selected="@{viewModel.uiState.appearance == Appearance.SYSTEM}"
                        android:onClick="@{() -> actions.setAppearance(Appearance.SYSTEM)}"
                        android:contentDescription="@string/voice_theme_system">
                        <ImageView android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_voice_system"
                            app:tint="@color/voice_option_text"
                            android:duplicateParentState="true"
                            android:importantForAccessibility="no" />
                        <TextView android:id="@+id/theme_system_label"
                            style="@style/Voice.Text.Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:textSize="13sp"
                            android:textColor="@color/voice_option_text"
                            android:duplicateParentState="true"
                            android:importantForAccessibility="no"
                            android:text="@string/voice_theme_system" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/theme_light"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/voice_option"
                        android:clickable="true"
                        android:focusable="true"
                        android:selected="@{viewModel.uiState.appearance == Appearance.LIGHT}"
                        android:onClick="@{() -> actions.setAppearance(Appearance.LIGHT)}"
                        android:contentDescription="@string/voice_theme_light">
                        <ImageView android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_voice_sun"
                            app:tint="@color/voice_option_text"
                            android:duplicateParentState="true"
                            android:importantForAccessibility="no" />
                        <TextView android:id="@+id/theme_light_label"
                            style="@style/Voice.Text.Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:textSize="13sp"
                            android:textColor="@color/voice_option_text"
                            android:duplicateParentState="true"
                            android:importantForAccessibility="no"
                            android:text="@string/voice_theme_light" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/theme_dark"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/voice_option"
                        android:clickable="true"
                        android:focusable="true"
                        android:selected="@{viewModel.uiState.appearance == Appearance.DARK}"
                        android:onClick="@{() -> actions.setAppearance(Appearance.DARK)}"
                        android:contentDescription="@string/voice_theme_dark">
                        <ImageView android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_voice_moon"
                            app:tint="@color/voice_option_text"
                            android:duplicateParentState="true"
                            android:importantForAccessibility="no" />
                        <TextView android:id="@+id/theme_dark_label"
                            style="@style/Voice.Text.Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:textSize="13sp"
                            android:textColor="@color/voice_option_text"
                            android:duplicateParentState="true"
                            android:importantForAccessibility="no"
                            android:text="@string/voice_theme_dark" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <View android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/voice_line" />
            <LinearLayout android:id="@+id/layout_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="28dp"
                android:paddingBottom="28dp">
                <TextView android:id="@+id/layout_label"
                    style="@style/Voice.SettingLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/voice_page_layout" />
                <LinearLayout android:layout_width="match_parent"
                    android:layout_height="59dp"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal"
                    android:padding="5dp"
                    android:background="@drawable/voice_segmented">
                    <TextView android:id="@+id/layout_left"
                        style="@style/Voice.SettingButton"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/voice_segment"
                        android:textColor="@color/voice_option_text"
                        android:text="@string/voice_controls_left"
                        android:selected="@{viewModel.uiState.controlsOnLeft}"
                        android:onClick="@{() -> actions.setControlsOnLeft(true)}" />
                    <TextView android:id="@+id/layout_right"
                        style="@style/Voice.SettingButton"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/voice_segment"
                        android:textColor="@color/voice_option_text"
                        android:text="@string/voice_controls_right"
                        android:selected="@{!viewModel.uiState.controlsOnLeft}"
                        android:onClick="@{() -> actions.setControlsOnLeft(false)}" />
                </LinearLayout>
            </LinearLayout>
            <View android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/voice_line" />
            <LinearLayout android:id="@+id/speed_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="28dp"
                android:paddingBottom="28dp">
                <TextView android:id="@+id/speed_label"
                    style="@style/Voice.SettingLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/voice_speed" />
                <LinearLayout android:id="@+id/speed_options"
                    android:layout_width="match_parent"
                    android:layout_height="59dp"
                    android:layout_marginTop="23dp"
                    android:orientation="horizontal"
                    android:padding="5dp"
                    android:background="@drawable/voice_segmented">
                    <TextView android:id="@+id/speed_slow"
                        style="@style/Voice.SettingButton"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/voice_segment"
                        android:textColor="@color/voice_option_text"
                        android:textSize="16sp"
                        android:text="@string/voice_speed_slow"
                        android:selected="@{viewModel.uiState.speed == 0}"
                        android:onClick="@{() -> actions.setSpeed(0)}" />
                    <TextView android:id="@+id/speed_normal"
                        style="@style/Voice.SettingButton"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/voice_segment"
                        android:textColor="@color/voice_option_text"
                        android:textSize="16sp"
                        android:text="@string/voice_speed_normal"
                        android:selected="@{viewModel.uiState.speed == 1}"
                        android:onClick="@{() -> actions.setSpeed(1)}" />
                    <TextView android:id="@+id/speed_fast"
                        style="@style/Voice.SettingButton"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/voice_segment"
                        android:textColor="@color/voice_option_text"
                        android:textSize="16sp"
                        android:text="@string/voice_speed_fast"
                        android:selected="@{viewModel.uiState.speed == 2}"
                        android:onClick="@{() -> actions.setSpeed(2)}" />
                </LinearLayout>
            </LinearLayout>
            <View android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/voice_line" />
            <LinearLayout android:id="@+id/reply_style_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="28dp"
                android:paddingBottom="28dp">
                <TextView android:id="@+id/reply_style_label"
                    style="@style/Voice.SettingLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/voice_reply_style" />
                <LinearLayout android:id="@+id/reply_style_options"
                    android:layout_width="match_parent"
                    android:layout_height="59dp"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal"
                    android:padding="5dp"
                    android:background="@drawable/voice_segmented">
                    <TextView android:id="@+id/reply_style_minimal"
                        style="@style/Voice.SettingButton"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/voice_segment"
                        android:textColor="@color/voice_option_text"
                        android:text="@string/voice_reply_style_minimal"
                        android:selected="@{viewModel.uiState.replyStyle == ReplyStyle.MINIMAL}"
                        android:onClick="@{() -> actions.setReplyStyle(ReplyStyle.MINIMAL)}" />
                    <TextView android:id="@+id/reply_style_simple"
                        style="@style/Voice.SettingButton"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/voice_segment"
                        android:textColor="@color/voice_option_text"
                        android:text="@string/voice_reply_style_simple"
                        android:selected="@{viewModel.uiState.replyStyle == ReplyStyle.SIMPLE}"
                        android:onClick="@{() -> actions.setReplyStyle(ReplyStyle.SIMPLE)}" />
                    <TextView android:id="@+id/reply_style_detailed"
                        style="@style/Voice.SettingButton"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/voice_segment"
                        android:textColor="@color/voice_option_text"
                        android:text="@string/voice_reply_style_detailed"
                        android:selected="@{viewModel.uiState.replyStyle == ReplyStyle.DETAILED}"
                        android:onClick="@{() -> actions.setReplyStyle(ReplyStyle.DETAILED)}" />
                </LinearLayout>
            </LinearLayout>
            <View android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/voice_line" />
            <LinearLayout android:id="@+id/answer_mode_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="28dp"
                android:paddingBottom="28dp">
                <TextView android:id="@+id/answer_mode_label"
                    style="@style/Voice.SettingLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/voice_answer_mode" />
                <LinearLayout android:id="@+id/answer_mode_options"
                    android:layout_width="match_parent"
                    android:layout_height="59dp"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal"
                    android:padding="5dp"
                    android:background="@drawable/voice_segmented">
                    <TextView android:id="@+id/answer_mode_single"
                        style="@style/Voice.SettingButton"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/voice_segment"
                        android:textColor="@color/voice_option_text"
                        android:text="@string/voice_answer_mode_single"
                        android:selected="@{viewModel.uiState.answerMode == AnswerMode.SINGLE}"
                        android:onClick="@{() -> actions.setAnswerMode(AnswerMode.SINGLE)}" />
                    <TextView android:id="@+id/answer_mode_chat"
                        style="@style/Voice.SettingButton"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/voice_segment"
                        android:textColor="@color/voice_option_text"
                        android:text="@string/voice_answer_mode_chat"
                        android:selected="@{viewModel.uiState.answerMode == AnswerMode.CHAT}"
                        android:onClick="@{() -> actions.setAnswerMode(AnswerMode.CHAT)}" />
                </LinearLayout>
                <TextView android:id="@+id/answer_mode_detail"
                    style="@style/Voice.SettingDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@{viewModel.uiState.answerMode == AnswerMode.SINGLE ? @string/voice_answer_mode_single_detail : @string/voice_answer_mode_chat_detail}" />
            </LinearLayout>
            <View android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/voice_line" />
            <LinearLayout android:id="@+id/captions_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="28dp"
                android:paddingBottom="28dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <LinearLayout android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:id="@+id/captions_label"
                        style="@style/Voice.SettingLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/voice_show_captions" />
                    <TextView android:id="@+id/captions_detail"
                        style="@style/Voice.SettingDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/voice_captions_detail" />
                </LinearLayout>
                <com.spake.brony.doubaoassistant.ui.widget.CaptionSwitchView android:id="@+id/captions_switch"
                    android:layout_width="54dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/voice_show_captions"
                    android:checked="@{viewModel.uiState.captions}"
                    android:background="@android:color/transparent"
                    android:onClick="@{() -> actions.toggleCaptions()}" />
            </LinearLayout>
            <View android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/voice_line" />
            <LinearLayout android:id="@+id/background_chat_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="28dp"
                android:paddingBottom="28dp">
                <LinearLayout android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="16dp"
                    android:orientation="vertical">
                    <TextView android:id="@+id/background_chat_label"
                        style="@style/Voice.SettingLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/voice_background_chat" />
                    <TextView android:id="@+id/background_chat_detail"
                        style="@style/Voice.SettingDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/voice_background_chat_detail" />
                </LinearLayout>
                <com.spake.brony.doubaoassistant.ui.widget.CaptionSwitchView android:id="@+id/background_chat_switch"
                    android:layout_width="54dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/voice_background_chat"
                    android:checked="@{viewModel.uiState.backgroundChat}"
                    android:background="@android:color/transparent"
                    android:onClick="@{() -> actions.toggleBackgroundChat()}" />
            </LinearLayout>
            <LinearLayout android:id="@+id/overlay_style_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="28dp"
                android:visibility="@{viewModel.uiState.backgroundChat ? View.VISIBLE : View.GONE}">
                <TextView android:id="@+id/overlay_style_label"
                    style="@style/Voice.SettingLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/voice_overlay_style" />
                <LinearLayout android:layout_width="match_parent"
                    android:layout_height="59dp"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal"
                    android:padding="5dp"
                    android:background="@drawable/voice_segmented">
                    <TextView android:id="@+id/overlay_style_minimal"
                        style="@style/Voice.SettingButton"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/voice_segment"
                        android:textColor="@color/voice_option_text"
                        android:text="@string/voice_overlay_style_minimal"
                        android:selected="@{viewModel.uiState.overlayStyle == OverlayStyle.MINIMAL}"
                        android:onClick="@{() -> actions.setOverlayStyle(OverlayStyle.MINIMAL)}" />
                    <TextView android:id="@+id/overlay_style_compact"
                        style="@style/Voice.SettingButton"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/voice_segment"
                        android:textColor="@color/voice_option_text"
                        android:text="@string/voice_overlay_style_compact"
                        android:selected="@{viewModel.uiState.overlayStyle == OverlayStyle.COMPACT}"
                        android:onClick="@{() -> actions.setOverlayStyle(OverlayStyle.COMPACT)}" />
                    <TextView android:id="@+id/overlay_style_detailed"
                        style="@style/Voice.SettingButton"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/voice_segment"
                        android:textColor="@color/voice_option_text"
                        android:text="@string/voice_overlay_style_detailed"
                        android:selected="@{viewModel.uiState.overlayStyle == OverlayStyle.DETAILED}"
                        android:onClick="@{() -> actions.setOverlayStyle(OverlayStyle.DETAILED)}" />
                </LinearLayout>
            </LinearLayout>
            <View android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/voice_line" />
            <LinearLayout android:id="@+id/name_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="28dp"
                android:paddingBottom="28dp">
                <LinearLayout android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="16dp"
                    android:orientation="vertical">
                    <TextView android:id="@+id/name_label"
                        style="@style/Voice.SettingLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/voice_assistant_name" />
                    <TextView android:id="@+id/name_value"
                        style="@style/Voice.Text.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textSize="18sp"
                        android:text="@{viewModel.uiState.assistantName}" />
                    <TextView android:id="@+id/name_detail"
                        style="@style/Voice.SettingDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@{@string/voice_name_commands(viewModel.uiState.assistantName)}" />
                </LinearLayout>
                <TextView android:id="@+id/change_name"
                    style="@style/Voice.SettingButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minWidth="64dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/voice_change_name"
                    android:onClick="@{() -> actions.changeAssistantName()}" />
            </LinearLayout>
            <View android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/voice_line" />
            <LinearLayout android:id="@+id/contacts_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="28dp"
                android:paddingBottom="28dp">
                <LinearLayout android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="16dp"
                    android:orientation="vertical">
                    <TextView style="@style/Voice.SettingLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/phone_contacts_title" />
                    <TextView style="@style/Voice.SettingDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/phone_contacts_detail" />
                </LinearLayout>
                <TextView android:id="@+id/manage_contacts"
                    style="@style/Voice.SettingButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minWidth="64dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/phone_contacts_manage"
                    android:onClick="@{() -> actions.managePhonePermissions()}" />
            </LinearLayout>
            <View android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/voice_line" />
            <LinearLayout android:id="@+id/credentials_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="28dp"
                android:paddingBottom="28dp">
                <LinearLayout android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="16dp"
                    android:orientation="vertical">
                    <TextView android:id="@+id/credentials_label"
                        style="@style/Voice.SettingLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/voice_service_credentials" />
                    <TextView android:id="@+id/credentials_detail"
                        style="@style/Voice.SettingDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/voice_edit_credentials_detail" />
                </LinearLayout>
                <TextView android:id="@+id/edit_credentials"
                    style="@style/Voice.SettingButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minWidth="64dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/voice_edit_credentials"
                    android:onClick="@{() -> actions.openCredentials()}" />
            </LinearLayout>
            <View android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/voice_line" />
            <LinearLayout android:id="@+id/history_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="28dp"
                android:paddingBottom="28dp">
                <LinearLayout android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="16dp"
                    android:orientation="vertical">
                    <TextView android:id="@+id/history_label"
                        style="@style/Voice.SettingLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/voice_history" />
                    <TextView android:id="@+id/history_detail"
                        style="@style/Voice.SettingDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/voice_clear_history_detail" />
                </LinearLayout>
                <TextView android:id="@+id/clear_history"
                    style="@style/Voice.SettingButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minWidth="64dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/voice_clear_history"
                    android:onClick="@{() -> actions.clearHistory()}" />
            </LinearLayout>
            <View android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/voice_line" />
            <LinearLayout android:id="@+id/permission_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="28dp"
                android:paddingBottom="28dp">
                <TextView android:id="@+id/permission_label"
                    style="@style/Voice.SettingLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/voice_mic_permission" />
                <TextView android:id="@+id/permission_detail"
                    style="@style/Voice.SettingDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:drawableStartCompat="@drawable/voice_permission_dot"
                    android:drawablePadding="7dp"
                    android:text="@string/voice_permission_enabled" />
            </LinearLayout>
            <Space android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
