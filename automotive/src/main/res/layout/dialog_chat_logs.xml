<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/voice_base">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView android:id="@+id/back"
            style="@style/Voice.SettingButton"
            android:layout_width="72dp"
            android:layout_height="48dp"
            android:text="@string/voice_logs_back" />
        <TextView
            style="@style/Voice.Text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="20dp"
            android:textSize="24sp"
            android:text="@string/voice_chat_logs_title" />
        <TextView android:id="@+id/refresh"
            style="@style/Voice.SettingButton"
            android:layout_width="72dp"
            android:layout_height="48dp"
            android:text="@string/voice_logs_refresh" />
    </LinearLayout>
    <View android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/voice_line" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="160dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/voice_panel">
            <TextView
                style="@style/Voice.Text.Secondary"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textSize="14sp"
                android:text="@string/voice_logs_tables" />
            <ListView android:id="@+id/tables"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:choiceMode="singleChoice"
                android:divider="@color/voice_line"
                android:dividerHeight="1dp" />
        </LinearLayout>
        <View android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/voice_line" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="20dp"
            android:orientation="vertical">
            <TextView android:id="@+id/records_title"
                style="@style/Voice.Text"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:textSize="16sp" />
            <TextView android:id="@+id/status"
                style="@style/Voice.Text.Secondary"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:gravity="center_vertical"
                android:accessibilityLiveRegion="polite"
                android:textSize="13sp" />
            <ListView android:id="@+id/records"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:divider="@color/voice_line"
                android:dividerHeight="1dp"
                android:transcriptMode="disabled" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
</layout>
